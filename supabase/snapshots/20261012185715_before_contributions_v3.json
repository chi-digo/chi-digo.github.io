        "functions": [
          {
            "def": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nbegin\n  insert into public.profiles (id, display_name, first_name, avatar_url)\n  values (\n    new.id,\n    coalesce(new.raw_user_meta_data-\u003e\u003e'display_name', new.raw_user_meta_data-\u003e\u003e'full_name', new.raw_user_meta_data-\u003e\u003e'name'),\n    nullif(split_part(coalesce(new.raw_user_meta_data-\u003e\u003e'full_name', new.raw_user_meta_data-\u003e\u003e'name', new.raw_user_meta_data-\u003e\u003e'display_name', ''), ' ', 1), ''),\n    coalesce(new.raw_user_meta_data-\u003e\u003e'avatar_url', new.raw_user_meta_data-\u003e\u003e'picture')\n  );\n  return new;\nexception\n  when others then\n    raise warning 'Failed to create profile for user %: %', new.id, sqlerrm;\n    return new;\nend;\n$function$\n",
            "definer": true,
            "n": "handle_new_user()"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.handle_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n",
            "definer": false,
            "n": "handle_updated_at()"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\nAS $function$\n  select exists (select 1 from public.profiles where id = auth.uid() and role = 'admin' and deleted_at is null);\n$function$\n",
            "definer": true,
            "n": "is_admin()"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.is_reviewer_for(target_scope text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\nAS $function$\n  select public.is_admin() or exists (\n    select 1 from public.profiles p join public.profile_review_scopes s on s.user_id = p.id\n    where p.id = auth.uid() and p.role = 'reviewer' and p.deleted_at is null\n      and (s.scope = target_scope or s.scope = 'all'));\n$function$\n",
            "definer": true,
            "n": "is_reviewer_for(text)"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.protect_profile_role()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  if new.role is distinct from old.role and current_user in ('authenticated', 'anon') then\n    raise exception 'role can only be changed by an admin';\n  end if;\n  return new;\nend;\n$function$\n",
            "definer": false,
            "n": "protect_profile_role()"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.reactivate_profile()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nbegin\n  update public.profiles p\n  set deleted_at = null,\n      avatar_url = coalesce(u.raw_user_meta_data-\u003e\u003e'avatar_url', u.raw_user_meta_data-\u003e\u003e'picture', p.avatar_url),\n      first_name = coalesce(p.first_name, nullif(split_part(coalesce(u.raw_user_meta_data-\u003e\u003e'full_name', u.raw_user_meta_data-\u003e\u003e'name', ''), ' ', 1), ''))\n  from auth.users u\n  where p.id = new.user_id and u.id = new.user_id;\n  return new;\nend;\n$function$\n",
            "definer": true,
            "n": "reactivate_profile()"
          },
          {
            "def": "CREATE OR REPLACE FUNCTION public.sync_agree_count()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nbegin\n  update public.contributions\n  set agree_count = (select count(*) from public.contribution_agreements where contribution_id = coalesce(new.contribution_id, old.contribution_id))\n  where id = coalesce(new.contribution_id, old.contribution_id);\n  return null;\nend;\n$function$\n",
            "definer": true,
            "n": "sync_agree_count()"
          }
